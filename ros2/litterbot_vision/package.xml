<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>litterbot_vision</name>
  <version>0.1.0</version>
  <description>
    Vision and sensor ingestion nodes for LitterBot. Publishes camera frames
    from the Jetson-attached USB camera and exposes status for the web UI.
  </description>

  <maintainer email="benji@litterbot.local">Benji</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
